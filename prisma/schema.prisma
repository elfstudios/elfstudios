// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth standard models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom user fields
  bandName      String?
  phone         String?

  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  bookingOrders BookingOrder[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App models
model Booking {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  orderId          String?
  order            BookingOrder? @relation(fields: [orderId], references: [id])
  
  attendees        Int
  date             DateTime // The date of the jam session
  originalDate     DateTime // Immutable first session date; anchors the reschedule window
  slots            String[] // Array of slot IDs (e.g. ["10", "11"])
  equipmentRequests String?
  ticketNumber     String?  @unique
  bandName         String?
  
  totalAmount      Float
  
  status           String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus    String   @default("UNPAID") // UNPAID, PENDING, PAID, FAILED, EXPIRED
  payuTxnId        String?  @unique // To store PayU transaction ID after success
  payuPaymentId    String?
  paidAt           DateTime?
  expiresAt        DateTime?
  cancelledAt      DateTime?
  cancelledBy      String?
  cancellationReason String?
  googleCalendarEventId String? @unique
  googleCalendarSyncedAt DateTime?

  changeRequests   BookingChangeRequest[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([date, status])
  @@index([userId, date])
  @@index([orderId])
  @@index([expiresAt])
}

// A single PayU checkout can reserve multiple sessions. Individual Booking
// records remain the source of truth for availability, cancellations and
// calendar events, while this model owns the shared payment and loyalty data.
model BookingOrder {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  attendees         Int
  bandName          String?
  equipmentRequests String?
  totalAmount       Float
  totalHours        Int
  freeHours         Int      @default(0)
  status            String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  paymentStatus     String   @default("UNPAID") // UNPAID, PENDING, PAID, FAILED, EXPIRED
  payuTxnId         String?  @unique
  payuPaymentId     String?
  paidAt            DateTime?
  expiresAt         DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?
  bookings          Booking[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BookingChangeRequest {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  requestedById  String
  type           String   // CANCEL or RESCHEDULE
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reason         String?
  requestedDate  DateTime?
  requestedSlots String[]
  adminNote      String?
  resolvedBy     String?
  resolvedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([bookingId, status])
  @@index([status, createdAt])
}

model CalendarBlock {
  id                    String   @id @default(cuid())
  date                  DateTime
  slots                 String[]
  note                  String?
  createdBy             String
  googleCalendarEventId String?  @unique
  googleCalendarSyncedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([date])
}
